# Broker config, leave empty to use local redis  default to redis://localhost:6379/0
PAIRAG_BROKER=

# Flag to enable CUDA (GPU acceleration)
USE_CUDA=0

# file_store config
FILE_STORE_TYPE=local
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=

MINERU_MODEL_SOURCE=local


# Transaction DB, Postgresql connection, Will use local sqllite3 if not provided.
DB_TYPE=sqlite3 # postgresql, sqlite3
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=


VECTOR_DB_TYPE=local #local, milvus, elasticsearch, postgresql

# USE Milvus vector store
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DATABASE=default


# USE Elasticsearch vector store
ELASTICSEARCH_URL=
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=


# USE PG vector store
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=


# ---------------------------------------------------------------------------
# OpenTelemetry tracing (optional). Records every AgentLoop step — LLM
# inference (input/output/tokens) and tool input/output — as a nested trace.
# Leave everything empty to run with tracing OFF (zero overhead).
#
# Option A — standard OTLP (any OpenTelemetry collector / Jaeger / Tempo):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # host:port of the OTLP service
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>  # auth headers (key=value,comma-separated)
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf                # http/protobuf (default) | grpc
# OTEL_SERVICE_NAME=pai-agent
# OTEL_TRACES_SAMPLER_ARG=1.0                              # sample ratio 0..1
# OTEL_TRACES_ENABLED=auto                                 # auto (default) | true | false
#
# Option B — Langfuse (endpoint + Basic auth are derived automatically):
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...


# ---------------------------------------------------------------------------
# File artifacts (publish_artifact / preview panel). Lets the agent surface a
# file it created under /mnt/user so the frontend can preview or download it.
# FILES_URL_SECRET signs the /v1/files access tokens — the feature fails closed
# (publish_artifact refuses) while it is empty, so set it to enable sharing.
# FILES_NAS_LOCAL_ROOT is the backend host's mount of the SAME NAS export the
# sandbox sees at /mnt/user; leave empty to serve by reading bytes back from the
# live sandbox instead. FILES_MAX_BYTES caps inline preview size (default 25MiB;
# larger files still get a download link).
# FILES_URL_SECRET=change-me-to-a-long-random-string
# FILES_NAS_LOCAL_ROOT=/mnt/nas/user
# FILES_MAX_BYTES=26214400
