# LLM Model Config
# LLM_PROVIDER = {YOUR_CONFIG}
LLM_MODEL_NAME = gpt-4o
LLM_API_KEY = sk-proj-xxxx
LLM_BASE_URL = https://api.openai.com/v1
LLM_TEMPERATURE = 0.0

# ===============Path Configurations=================
GAIA_DATASET_PATH="~/AWorld/examples/gaia/GAIA/2023"
AWORLD_WORKSPACE="~/AWorld/tmp"

# ===============MCP Server Configurations=================
# [Google Search API](https://developers.google.com/custom-search/v1/introduction)
GOOGLE_API_KEY=xxx
GOOGLE_CSE_ID=xxx

# [Browser Use](https://github.com/browser-use/browser-use)
SKIP_LLM_API_KEY_VERIFICATION=true
OPENAI_API_KEY=sk-proj-xxxx
COOKIES_FILE_PATH=/root/xiaowen/AWorld/tmp/cookies

# Audio Server
AUDIO_LLM_API_KEY=sk-proj-xxxx
AUDIO_LLM_BASE_URL=https://api.openai.com/v1
AUDIO_LLM_MODEL_NAME=gpt-4o

# Image Server
IMAGE_LLM_API_KEY=sk-proj-xxxx
IMAGE_LLM_BASE_URL=https://api.openai.com/v1
IMAGE_LLM_MODEL_NAME=gpt-4o

# Video Server
VIDEO_LLM_API_KEY=sk-proj-xxxx
VIDEO_LLM_BASE_URL=https://api.openai.com/v1
VIDEO_LLM_MODEL_NAME=gpt-4o
VIDEO_LLM_TEMPERATURE=1.0

# Code Server
CODE_LLM_API_KEY=sk-proj-xxxx
CODE_LLM_BASE_URL=https://api.openai.com/v1
CODE_LLM_MODEL_NAME=gpt-4o

# Think Server
THINK_LLM_API_KEY=sk-proj-xxxx
THINK_LLM_BASE_URL=https://api.openai.com/v1
THINK_LLM_MODEL_NAME=gpt-4o

# Guard Server
GUARD_LLM_API_KEY=sk-proj-xxxx
GUARD_LLM_BASE_URL=https://api.openai.com/v1
GUARD_LLM_MODEL_NAME=gpt-4o

# [E2B Server](https://e2b.dev/docs/quickstart)
E2B_API_KEY={YOUR_CONFIG}
