# LLM backend
# Required for real LLM calls. OPENAI_API_KEY is used only when API_KEY is empty.
API_KEY=
# OPENAI_API_KEY=
API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen-plus
MAX_TOKENS=8192
MAX_TURNS=40
HISTORY_TRIM_TOKENS=80000
TIMEOUT=300

# HTTP backend
MODEL_ALIASES=mini-agent,agent
SERVER_CORS_ORIGINS=*
MAX_REQUEST_BODY_BYTES=8388608
EXPOSE_SESSION_DEBUG=false

# Workspace / memory
WORKSPACE_ROOT=./workspaces
ENFORCE_WORKSPACE_FOR_SERVER=false
ENABLE_SHARED_MEMORY_FOR_USERS=false
ENABLE_LONG_TERM_MEMORY_FOR_USERS=false
BACKGROUND_MEMORY_REVIEW_ENABLED=true
BACKGROUND_MEMORY_REVIEW_MAX_TURNS=8

# Concurrency / persistence
MAX_GLOBAL_RUNS=0
MAX_USER_RUNS=0
SQLITE_JOURNAL_MODE=DELETE

# Runner and Redis
# Empty lets start.sh choose celery when worker/api scaling needs it.
RUNNER_BACKEND=
REDIS_URL=redis://127.0.0.1:6379/0
# Empty uses REDIS_URL.
CELERY_BROKER_URL=
RUN_EVENT_TTL_SECONDS=86400
ASK_USER_TIMEOUT_SECONDS=1800
RUN_IDLE_TIMEOUT_SECONDS=3600
SSE_HEARTBEAT_SECONDS=15

# start.sh runtime
PORT=8680
FRONTEND_PORT=8681
BACKEND_PORT=8682
API_INSTANCE_COUNT=1
WORKER_INSTANCE_COUNT=2
DEV_MODE=false
HOST=0.0.0.0
START_REDIS=auto
# NGINX_CONFIG=/etc/nginx/conf.d/pai-rag.conf

# Frontend server proxy
# start.sh overrides this to http://127.0.0.1:${BACKEND_PORT} for managed startup.
BACKEND_BASE_URL=http://127.0.0.1:8000
