# AgentArena service auth
# If set, every /api/* request must include Authorization: Bearer <ARENA_API_KEY>.
ARENA_API_KEY=change-me-arena-key

# Agent A
AGENT_A_NAME=Hermes Agent
AGENT_A_BASE_URL=http://127.0.0.1:8642
AGENT_A_API_KEY=change-me-agent-a
AGENT_A_MODEL=hermes-agent
# responses: /v1/responses. chat: external /v1/chat/completions only.
# runs: external /v1/runs + /v1/runs/{id}/events for trace.
AGENT_A_TRACE_MODE=responses
# Optional. Defaults to AGENT_A_BASE_URL.
AGENT_A_RUNS_BASE_URL=

# Agent B
AGENT_B_NAME=PAI-RAG MiniAgent
AGENT_B_BASE_URL=http://127.0.0.1:8000
AGENT_B_API_KEY=change-me-agent-b
AGENT_B_MODEL=mini-agent
AGENT_B_TRACE_MODE=responses
AGENT_B_RUNS_BASE_URL=

# Judge
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_OPENAI_API_KEY=
# OPENAI_API_KEY can also be used as fallback.
JUDGE_MODEL=gpt-4.1-mini

# Optional
REQUEST_TIMEOUT_SECONDS=180
JUDGE_TIMEOUT_SECONDS=180
# Defaults to data/arena_history.sqlite3.
HISTORY_DB_PATH=
